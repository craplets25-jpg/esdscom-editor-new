{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core Launch (Server)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder:esdscom-editor-new}/Server/bin/Debug/net10.0/eSDSCom.Editor.Server.dll",
            "args": [],
            "cwd": "${workspaceFolder:esdscom-editor-new}/Server",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ConnectionStrings__DefaultConnection": "Server=localhost;Port=5432;Database=esdscom;User Id=postgres;Password=postgres;"
            },
            "sourceFileMap": {
                "/Views": "${workspaceFolder:esdscom-editor-new}/Views"
            }
        }
    ]
}
